# Copy this file to ".env" and fill in your values.
# On most systems:  cp .env.example .env

# ---- Storage (required — Supabase) ----
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the project's SQL Editor
# 3. Copy these two values from  Project Settings → API
SUPABASE_URL=
# The SERVICE ROLE key (Project Settings → API → "service_role"). It is a
# secret with full access — keep it server-side only, never in the browser
# or in git. (The .gitignore already excludes this .env file.)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the Storage bucket name. Defaults to "documents" (matches schema.sql).
# SUPABASE_BUCKET=documents

# ---- AI Agent (required for the agent to work) ----
# Get a key at https://console.anthropic.com/  ->  API Keys
ANTHROPIC_API_KEY=

# The Claude model the agent uses. Change this if your account uses a different model id.
AGENT_MODEL=claude-sonnet-4-5

# ---- Owner protection (optional but recommended before hosting online) ----
# If you set a password here, the owner dashboard will ask for it before showing your clients.
# Leave it blank while testing on your own computer.
OWNER_PASSWORD=

# ---- Server ----
PORT=3000
